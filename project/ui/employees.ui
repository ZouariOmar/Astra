  <property name="styleSheet">
   <string notr="true">* {
	background-color: rgb(245, 239, 235);
}

QComboBox {
	background-color: white;
}

QPushButton {
	border-radius: 12px;
	background-color: white;
}

#Add_button:hover {
	background-color: rgb(246, 245, 244);
}

Line {
	background-color: rgb(147, 155, 167);
}

/* ### From Elements ### */
#Form, #updateForm {
	border-radius: 20px;
	background-color: rgb(255, 255, 255);
}

#Cancel_form, #Cancel_form_2 {
    border-radius: 10px;
    border: none;
    background-color: rgba(47, 65, 86, 0.5);
}

#Cancel_form:hover {
    background-color: rgba(47, 65, 86, 1);
}

#Form &gt; QLineEdit, #updateForm &gt; QLineEdit, #departmentInsert_2, #birthdateInsert_2, #statusUpdate {
	background-color: rgb(246, 245, 244);
	border-radius: 8px;
	padding-left: 30px;
}

#insertBtn, #updateBtn {
	background-color: rgba(209, 184, 155, 1);
	border: none;
	border-radius: 8px;
	font: 10pt &quot;Verdana&quot;;
	color: black;
}

#insertBtn:hover {
	background-color: rgba(175, 153, 126, 1); 
}

#dateEdit {
	background-color: rgb(246, 245, 244);
	border-radius: 8px;
	padding-left: 30px;
}

#Filtre_2 {
	background-color: rgb(246, 245, 244);
	border-radius: 8px;
	padding-left: 30px;
}

#show:hover {
	text-decoration: underline;
}
/* ### / From Elements ### */

/* ### Employees Table View ### */
#EmployeesTableView {
	background-color: rgb(246, 245, 244);
	border-radius: 8px;
	padding-left: 30px;
}
/* ### / Employees Table View ### */

</string>
