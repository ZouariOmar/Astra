  <property name="styleSheet">
   <string notr="true">/* Login interface */
QGroupBox {
  border: 1px solid rgb(153, 193, 241);
  border-radius: 20px;
  background-color: qlineargradient(
    spread: pad,
    x1: 0.46798,
    y1: 0,
    x2: 0.483,
    y2: 0.420318,
    stop: 0 rgba(0, 158, 255, 94),
    stop: 1 rgba(0, 0, 0, 0)
  );
}

/* Uername and password lineEdit */
QLineEdit {
	border: 1px solid black;
    border-radius: 10px;
    padding: 5px;
	padding-left: 30px;
}

QLineEdit:focus {
    border: 1px solid rgb(153, 193, 241);  /* Change this to your desired color */
}

/* Target both buttons (of login sub _interface and forget password sub_interface) */
QPushButton {
    border: 1px solid rgb(153, 193, 241);
    border-radius: 10px;
    color: white;
    background-color: transparent;
}

/* Hover effect */
QPushButton:hover {
    background-color: rgba(153, 193, 241, 0.5);
}

/* Pressed effect */
QPushButton:pressed {
    background-color: darkgray;
    border: 1px solid black;
}

QPushButton#hide_show_btn, #hide_show_btn_2 {
	border: 0px solid rgb(153, 193, 241);
    background-color: transparent;
}
</string>
  </property>
